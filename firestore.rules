rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Weekly Leaderboard records
    // Document ID is `${cycleId}_${userId}`
    match /weekly_leaderboard/{docId} {
      allow read, write: if true;
    }

    // Historical archives
    match /weekly_archives/{docId} {
      allow read, write: if true;
    }
  }
}
